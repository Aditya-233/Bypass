def cmd_service(args):
    action = args.action
    service_dir = Path.home() / ".config" / "systemd" / "user"
    service_file = service_dir / "bypass.service"

    bypass_bin = BASE_DIR / "bypass"

    if action in ["install", "enable"]:
        service_dir.mkdir(parents=True, exist_ok=True)
        content = f"""[Unit]
Description=DPI Bypass Proxy Service
After=network.target

[Service]
Type=forking
ExecStart={bypass_bin} start
ExecStop={bypass_bin} stop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
"""
        service_file.write_text(content)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "enable", "bypass.service"])
        subprocess.run(["systemctl", "--user", "start", "bypass.service"])
        print(colorize(f"[✓] Installed and enabled systemd user service: {service_file}", Colors.GREEN))
        print(colorize("It is running now and will automatically start on every login!", Colors.CYAN))

    elif action in ["uninstall", "disable"]:
        subprocess.run(["systemctl", "--user", "stop", "bypass.service"], capture_output=True)
        subprocess.run(["systemctl", "--user", "disable", "bypass.service"], capture_output=True)
        service_file.unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        print(colorize("[✓] Uninstalled systemd user service.", Colors.GREEN))

def main():
    parser = argparse.ArgumentParser(
        prog="bypass",
        description="High-Performance Low-Level DPI Bypass Suite (Nyaa, FitGirl, Torrent & Educational Sites)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  bypass start                    # Start background DPI bypass services
  bypass status                   # Show status and port bindings
  bypass test                     # Test access to nyaa.si, fitgirl, etc.
  bypass run curl https://nyaa.si # Run curl wrapped with proxy env
  bypass browser                  # Launch Firefox through bypass
  bypass service install          # Enable auto-start on user login
  bypass stop                     # Stop services
"""
    )

    subparsers = parser.add_subparsers(dest="subcommand")

    # start
    p_start = subparsers.add_parser("start", help="Start background bypass daemon")
    p_start.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT, help=f"SOCKS5 port (default: {DEFAULT_SOCKS_PORT})")
    p_start.add_argument("--http-port", type=int, default=DEFAULT_HTTP_PORT, help=f"HTTP proxy port (default: {DEFAULT_HTTP_PORT})")
    p_start.add_argument("--listen-ip", default=DEFAULT_LISTEN_IP, help=f"Listening IP (default: {DEFAULT_LISTEN_IP})")
    p_start.set_defaults(func=cmd_start)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop bypass daemon")
    p_stop.set_defaults(func=cmd_stop)

    # restart
    p_restart = subparsers.add_parser("restart", help="Restart bypass daemon")
    p_restart.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT)
    p_restart.add_argument("--http-port", type=int, default=DEFAULT_HTTP_PORT)
    p_restart.add_argument("--listen-ip", default=DEFAULT_LISTEN_IP)
    p_restart.set_defaults(func=cmd_restart)

    # status
    p_status = subparsers.add_parser("status", help="Show status of bypass daemon")
    p_status.set_defaults(func=cmd_status)

    # test
    p_test = subparsers.add_parser("test", help="Test reachability of blocked websites")
    p_test.add_argument("urls", nargs="*", help="Optional URLs to test")
    p_test.add_argument("--timeout", type=int, default=12, help="Timeout in seconds (default: 12)")
    p_test.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT)
    p_test.add_argument("--http-port", type=int, default=DEFAULT_HTTP_PORT)
    p_test.add_argument("--listen-ip", default=DEFAULT_LISTEN_IP)
    p_test.set_defaults(func=cmd_test)

    # run
    p_run = subparsers.add_parser("run", help="Run any command with proxy environment variables set")
    p_run.add_argument("command", nargs=argparse.REMAINDER, help="Command to run")
    p_run.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT)
    p_run.add_argument("--http-port", type=int, default=DEFAULT_HTTP_PORT)
    p_run.add_argument("--listen-ip", default=DEFAULT_LISTEN_IP)
    p_run.set_defaults(func=cmd_run)

    # env
    p_env = subparsers.add_parser("env", help="Print export commands for terminal session")
    p_env.set_defaults(func=cmd_env)

    # unenv
    p_unenv = subparsers.add_parser("unenv", help="Print unset commands for terminal session")
    p_unenv.set_defaults(func=cmd_unenv)

    # browser
    p_browser = subparsers.add_parser("browser", help="Launch browser with bypass configured")
    p_browser.add_argument("urls", nargs="*", help="URLs to open")
    p_browser.add_argument("--socks-port", type=int, default=DEFAULT_SOCKS_PORT)
    p_browser.add_argument("--http-port", type=int, default=DEFAULT_HTTP_PORT)
    p_browser.add_argument("--listen-ip", default=DEFAULT_LISTEN_IP)
    p_browser.set_defaults(func=cmd_browser)

    # service
    p_svc = subparsers.add_parser("service", help="Manage systemd user service")
    p_svc.add_argument("action", choices=["install", "uninstall", "enable", "disable"], help="Service action")
    p_svc.set_defaults(func=cmd_service)

    args = parser.parse_args()
    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    args.func(args)

if __name__ == "__main__":
    main()

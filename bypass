#!/usr/bin/env python3
"""
BYPASS - High-Performance Low-Level DPI Bypass & Censorship Circumvention Suite
Bypasses middlebox/firewall TLS SNI Inspection (Fortinet, Indian ISPs, College/Enterprise Firewalls)
"""

import sys
import os
import time
import json
import signal
import socket
import subprocess
import argparse
from pathlib import Path

# Paths
BASE_DIR = Path(__file__).resolve().parent
BIN_ENGINE = BASE_DIR / "bin" / "bypass-engine"
HTTP_PROXY_SCRIPT = BASE_DIR / "bypass_http_proxy.py"
RUN_DIR = Path.home() / ".config" / "bypass"
WHITELIST_FILE = BASE_DIR / "speed_whitelist.txt"
CONFIG_FILE = RUN_DIR / "config.json"
PID_ENGINE_FILE = RUN_DIR / "engine.pid"
PID_HTTP_FILE = RUN_DIR / "http.pid"

DEFAULT_SOCKS_PORT = 1080
DEFAULT_HTTP_PORT = 8080
DEFAULT_LISTEN_IP = "127.0.0.1"

# ANSI Colors
class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    DIM = '\033[2m'
    RESET = '\033[0m'

def colorize(text, color):
    if sys.stdout.isatty():
        return f"{color}{text}{Colors.RESET}"
    return text

def ensure_dirs():
    RUN_DIR.mkdir(parents=True, exist_ok=True)

def is_pid_running(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False

def read_pid(path):
    if path.exists():
        try:
            val = int(path.read_text().strip())
            if is_pid_running(val):
                return val
        except Exception:
            pass
    return None

def write_pid(path, pid):
    path.write_text(str(pid))

def is_port_in_use(port, host="127.0.0.1"):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex((host, port)) == 0

def ensure_engine_binary():
    if not BIN_ENGINE.exists():
        print(colorize("[*] Compiling bypass engine from source...", Colors.YELLOW))
        build_script = BASE_DIR / "build.sh"
        if build_script.exists():
            res = subprocess.run(["bash", str(build_script)], cwd=str(BASE_DIR))
            if res.returncode != 0:
                print(colorize("[!] Failed to build bypass-engine!", Colors.RED))
                sys.exit(1)
        else:
            print(colorize(f"[!] Engine binary not found at {BIN_ENGINE} and build.sh missing!", Colors.RED))
            sys.exit(1)

def cmd_start(args):
    ensure_dirs()
    ensure_engine_binary()

    socks_port = getattr(args, "socks_port", DEFAULT_SOCKS_PORT)
    http_port = getattr(args, "http_port", DEFAULT_HTTP_PORT)
    listen_ip = getattr(args, "listen_ip", DEFAULT_LISTEN_IP)

    engine_pid = read_pid(PID_ENGINE_FILE)
    http_pid = read_pid(PID_HTTP_FILE)

    if engine_pid and http_pid:
        print(colorize("[!] Bypass is already running!", Colors.YELLOW))
        cmd_status(args)
        return

    # Clean up stale pid files
    if engine_pid and not http_pid:
        try: os.kill(engine_pid, signal.SIGTERM)
        except Exception: pass
    if http_pid and not engine_pid:
        try: os.kill(http_pid, signal.SIGTERM)
        except Exception: pass

    if is_port_in_use(socks_port, listen_ip):
        print(colorize(f"[!] SOCKS5 port {socks_port} is already in use by another process!", Colors.RED))
        return

    if is_port_in_use(http_port, listen_ip):
        print(colorize(f"[!] HTTP proxy port {http_port} is already in use by another process!", Colors.RED))
        return

    print(colorize("Starting Bypass Services...", Colors.BOLD))

    # Native C DPI Bypass Engine (SOCKS5):
    # -K t --ex-hosts <file> -s 1 -o 1: Desynchronize TLS ClientHello with Out-Of-Band URG for blocked HTTPS (port 443)
    # -A n -K h --ex-hosts <file> -o 1+h: Desynchronize HTTP Host header with Out-Of-Band URG for blocked HTTP (port 80)
    # -A n: Fallback passthrough for whitelisted speedtest/CDN domains (no desync -> native line speed)
    engine_cmd = [
        str(BIN_ENGINE),
        "-i", listen_ip,
        "-p", str(socks_port),
        "-X",
        "-b", "65536",
        "-K", "t",
        "--ex-hosts", str(WHITELIST_FILE),
        "-s", "1",
        "-o", "1",
        "-A", "n",
        "-K", "h",
        "--ex-hosts", str(WHITELIST_FILE),
        "-o", "1+h",
        "-A", "n",
        "-w", str(PID_ENGINE_FILE),
        "-D"
    ]

    try:
        res = subprocess.run(engine_cmd, capture_output=True, text=True)
        if res.returncode != 0:
            print(colorize(f"[!] Failed to start native engine: {res.stderr}", Colors.RED))
            return
    except Exception as e:
        print(colorize(f"[!] Failed to launch engine: {e}", Colors.RED))
        return

    time.sleep(0.3)
    engine_pid = read_pid(PID_ENGINE_FILE)
    if not engine_pid:
        print(colorize("[!] Engine process died immediately after starting!", Colors.RED))
        return

    print(colorize(f"  [+] SOCKS5 DPI Engine running on {listen_ip}:{socks_port} (PID: {engine_pid})", Colors.GREEN))

    # HTTP to SOCKS5 Forwarder
    http_proc = subprocess.Popen(
        [
            sys.executable,
            str(HTTP_PROXY_SCRIPT),
            "--listen-ip", listen_ip,
            "--listen-port", str(http_port),
            "--socks-host", listen_ip,
            "--socks-port", str(socks_port),
            "--pidfile", str(PID_HTTP_FILE)
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )
    time.sleep(0.3)
    http_pid = read_pid(PID_HTTP_FILE)
    if not http_pid:
        http_pid = http_proc.pid
        write_pid(PID_HTTP_FILE, http_pid)

    print(colorize(f"  [+] HTTP CONNECT Proxy running on {listen_ip}:{http_port} (PID: {http_pid})", Colors.GREEN))

    config = {
        "listen_ip": listen_ip,
        "socks_port": socks_port,
        "http_port": http_port,
        "started_at": time.time()
    }
    CONFIG_FILE.write_text(json.dumps(config, indent=2))

    print(colorize("\n[✓] Bypass is ACTIVE and ready!", Colors.BOLD + Colors.GREEN))
    print(colorize("Usage tips:", Colors.CYAN))
    print(f"  • Test blocked sites:    {colorize('bypass test', Colors.BOLD)}")
    print(f"  • Run command via proxy: {colorize('bypass run <command>', Colors.BOLD)}")
    print(f"  • Launch Firefox:        {colorize('bypass browser', Colors.BOLD)}")
    print(f"  • Export env variables:  {colorize('eval $(bypass env)', Colors.BOLD)}")

def cmd_stop(args):
    engine_pid = read_pid(PID_ENGINE_FILE)
    http_pid = read_pid(PID_HTTP_FILE)

    stopped_any = False

    if http_pid:
        try:
            os.kill(http_pid, signal.SIGTERM)
            print(colorize(f"  [-] Stopped HTTP proxy (PID: {http_pid})", Colors.YELLOW))
            stopped_any = True
        except Exception:
            pass
        if PID_HTTP_FILE.exists():
            PID_HTTP_FILE.unlink(missing_ok=True)

    if engine_pid:
        try:
            os.kill(engine_pid, signal.SIGTERM)
            print(colorize(f"  [-] Stopped SOCKS5 engine (PID: {engine_pid})", Colors.YELLOW))
            stopped_any = True
        except Exception:
            pass
        if PID_ENGINE_FILE.exists():
            PID_ENGINE_FILE.unlink(missing_ok=True)

    # Clean up leftover processes if any
    subprocess.run(["pkill", "-f", "bypass-engine"], capture_output=True)
    subprocess.run(["pkill", "-f", "bypass_http_proxy.py"], capture_output=True)

    if PID_ENGINE_FILE.exists(): PID_ENGINE_FILE.unlink(missing_ok=True)
    if PID_HTTP_FILE.exists(): PID_HTTP_FILE.unlink(missing_ok=True)

    if stopped_any:
        print(colorize("[✓] Bypass services successfully stopped.", Colors.GREEN))
    else:
        print(colorize("[*] No active bypass services were running.", Colors.DIM))

def cmd_restart(args):
    cmd_stop(args)
    time.sleep(0.5)
    cmd_start(args)

def cmd_status(args):
    engine_pid = read_pid(PID_ENGINE_FILE)
    http_pid = read_pid(PID_HTTP_FILE)

    config = {}
    if CONFIG_FILE.exists():
        try:
            config = json.loads(CONFIG_FILE.read_text())
        except Exception:
            pass

    socks_port = config.get("socks_port", DEFAULT_SOCKS_PORT)
    http_port = config.get("http_port", DEFAULT_HTTP_PORT)
    listen_ip = config.get("listen_ip", DEFAULT_LISTEN_IP)

    print(colorize("--- Bypass Service Status ---", Colors.BOLD))
    
    if engine_pid:
        print(f"  • SOCKS5 Engine: {colorize('ONLINE', Colors.GREEN)} (PID: {engine_pid}, Address: {listen_ip}:{socks_port})")
    else:
        print(f"  • SOCKS5 Engine: {colorize('OFFLINE', Colors.RED)}")

    if http_pid:

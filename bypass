    # Check if running
    if not read_pid(PID_ENGINE_FILE) and not is_port_in_use(socks_port, listen_ip):
        print(colorize("[*] Bypass is not running. Starting temporarily for test...", Colors.YELLOW))
        cmd_start(args)

    targets = args.urls if args.urls else [
        "https://nyaa.si",
        "https://fitgirl-repacks.site",
        "https://1337x.to",
        "https://thepiratebay.org",
        "https://rutracker.org",
        "https://www.reddit.com",
        "https://github.com"
    ]

    proxy_url = f"http://{listen_ip}:{http_port}"
    socks_url = f"socks5h://{listen_ip}:{socks_port}"

    print(colorize(f"Testing connectivity through Bypass Proxy ({proxy_url} & {socks_url})...\n", Colors.BOLD))
    print(f"{'Target Website':<32} {'HTTP Code':<16} {'Latency':<10} {'Result'}")
    print("-" * 72)

    for target in targets:
        ret, code, latency = test_url_curl(target, socks_url, timeout=args.timeout)
        
        if ret == 0 and (code.startswith("2") or code.startswith("3") or code == "403"):
            if code == "403":
                status_str = colorize(f"{code} (Origin/WAF)", Colors.YELLOW)
                res_str = colorize("UNBLOCKED (DPI Bypassed)", Colors.GREEN)
            else:
                status_str = colorize(f"{code} OK", Colors.GREEN)
                res_str = colorize("UNBLOCKED (Success)", Colors.BOLD + Colors.GREEN)
        elif code == "TIMEOUT":
            status_str = colorize("TIMEOUT", Colors.RED)
            res_str = colorize("FAILED", Colors.RED)
        else:
            status_str = colorize(f"Code {code}", Colors.RED)
            res_str = colorize(f"Error ({ret})", Colors.RED)

        print(f"{target:<32} {status_str:<25} {latency:>5}ms   {res_str}")

    print("\n" + colorize("[✓] Verification test completed.", Colors.BOLD + Colors.GREEN))

def cmd_run(args):
    if not args.command:
        print(colorize("Usage: bypass run <command> [args...]", Colors.RED))
        sys.exit(1)

    config = {}
    if CONFIG_FILE.exists():
        try:
            config = json.loads(CONFIG_FILE.read_text())
        except Exception:
            pass

    http_port = config.get("http_port", DEFAULT_HTTP_PORT)
    socks_port = config.get("socks_port", DEFAULT_SOCKS_PORT)
    listen_ip = config.get("listen_ip", DEFAULT_LISTEN_IP)

    # Ensure proxy is running
    if not read_pid(PID_ENGINE_FILE) and not is_port_in_use(socks_port, listen_ip):
        print(colorize("[*] Starting bypass daemon...", Colors.YELLOW))
        cmd_start(args)

    env = os.environ.copy()
    proxy_http = f"http://{listen_ip}:{http_port}"
    proxy_socks = f"socks5h://{listen_ip}:{socks_port}"

    env["http_proxy"] = proxy_http
    env["https_proxy"] = proxy_http
    env["HTTP_PROXY"] = proxy_http
    env["HTTPS_PROXY"] = proxy_http
    env["all_proxy"] = proxy_http
    env["ALL_PROXY"] = proxy_http

    # Execute wrapped process
    try:
        p = subprocess.run(args.command, env=env)
        sys.exit(p.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
    except FileNotFoundError:
        print(colorize(f"Command not found: {args.command[0]}", Colors.RED))
        sys.exit(127)


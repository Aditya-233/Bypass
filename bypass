        print(colorize("\nService is running normally. Run 'bypass test' to verify connectivity.", Colors.CYAN))
    else:
        print(colorize("\nService is stopped. Run 'bypass start' to enable.", Colors.YELLOW))

def test_url_curl(url, proxy_url, timeout=15):
    start = time.time()
    cmd = [
        "curl",
        "-x", proxy_url,
        "-s",
        "-L",
        "--connect-timeout", "5",
        "-m", str(timeout),
        "--retry", "2",
        "--retry-delay", "1",
        "--compressed",
        "-H", "User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0",
        "-w", "%{http_code}\n",
        "-o", "/dev/null",
        url
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 2)
        elapsed = round((time.time() - start) * 1000)
        lines = res.stdout.strip().split("\n")
        code = lines[0] if len(lines) > 0 and lines[0] else "000"
        return res.returncode, code, elapsed
    except subprocess.TimeoutExpired:
        return 28, "TIMEOUT", int(timeout * 1000)
    except Exception as e:
        return -1, str(e), 0

